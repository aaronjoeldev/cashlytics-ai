# Cashlytics configuration. Copy to .env and fill in the values.

# --- Database (required) -------------------------------------------------------
# Inside Docker Compose the host is "postgres". For `scripts/dev.sh` use
# postgresql://cashlytics:cashlytics_secret@localhost:5432/cashlytics
DATABASE_URL=postgresql://cashlytics:your_secure_password@postgres:5432/cashlytics
POSTGRES_PASSWORD=your_secure_password

# --- App and sessions (required) -------------------------------------------------
# Public URL of this instance, e.g. https://cashlytics.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Keep true for any deployment that is not plain localhost (proxy, IP, domain)
AUTH_TRUST_HOST=true

# true: only the first account can register. false: open registration.
SINGLE_USER_MODE=true

# Fallback language (de, en) and currency for new users. Compiled in at build time,
# so they only apply to images you build yourself; users change both in the settings.
NEXT_PUBLIC_DEFAULT_LOCALE=de
NEXT_PUBLIC_DEFAULT_CURRENCY=EUR

# --- AI features (optional) ---------------------------------------------------
# Enables the assistant, the receipt scanner and the CSV import.
# OPENAI_API_KEY=sk-...

# --- E-mail (optional) --------------------------------------------------------
# Password reset and welcome mails. Without it the app works, but passwords cannot be reset.
# EMAIL_TRANSPORT=smtp          # or "sendmail" for a local Postfix/Exim (needs a sendmail binary; the Docker image has none, use smtp there)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                 # 587 STARTTLS, 465 TLS
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com # defaults to SMTP_USER
# APP_URL=https://cashlytics.example.com  # base for links in mails, defaults to NEXT_PUBLIC_APP_URL

# --- Push notifications and scheduled jobs (optional) -------------------------
# Key pair: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Required by the cron container for payment reminders and the assistant's daily insights.
# Generate with: openssl rand -hex 32
# CRON_SECRET=
# NOTIFICATION_SCHEDULE=0 8 * * *   # UTC
# INSIGHTS_SCHEDULE=0 6 * * *       # UTC
